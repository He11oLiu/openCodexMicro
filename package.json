{
  "name": "open-codex-micro",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Turn a Ulanzi D200 into openCodexMicro",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s test -p '*_test.py'",
